# ============================================================
# Tech For You — Environment Variables for Vercel Deployment
# ============================================================

# 1. DATABASE_URL / POSTGRES_URL (CRITICAL FOR VERCEL PERSISTENCE)
# Your Neon PostgreSQL connection string (prefer pooled connection for serverless).
# From Neon Console -> Dashboard -> Connection String -> Direct or Pooled (ep-soft-...-pooler).
DATABASE_URL="postgresql://neondb_owner:npg_Nei9j8zKdlPA@ep-soft-salad-ao55des9-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
POSTGRES_URL="postgresql://neondb_owner:npg_Nei9j8zKdlPA@ep-soft-salad-ao55des9-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# 2. JWT_SECRET (ADMIN AUTHENTICATION)
# Secret key used for signing administrative JWT tokens.
JWT_SECRET="tech-for-you-super-secure-jwt-secret-key-2026"

# 3. APP_URL (PUBLIC DOMAIN FOR QR CODES & VERIFICATION)
# Your deployed Vercel domain without trailing slash.
# Used to encode the official QR code verification URLs onto certificates.
APP_URL="https://your-project.vercel.app"

# 4. NODE_ENV
# Automatically set to 'production' by Vercel.
NODE_ENV="production"
